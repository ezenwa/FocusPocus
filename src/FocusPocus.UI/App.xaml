<Application x:Class="FocusPocus.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
      </ResourceDictionary.MergedDictionaries>
      <Color x:Key="FocusYellow">#FFDD55</Color>
      <Color x:Key="FocusPurple">#35007F</Color>
      <SolidColorBrush x:Key="AppBackgroundBrush" Color="#160B24" />
      <SolidColorBrush x:Key="PaneBrush" Color="#24113B" />
      <SolidColorBrush x:Key="CardBrush" Color="#E62D1549" />
      <SolidColorBrush x:Key="CardStrokeBrush" Color="#8062408A" />
      <SolidColorBrush x:Key="MutedBrush" Color="#D8CBE7" />
      <SolidColorBrush x:Key="FocusAccentBrush" Color="#FFDD55" />
      <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FFDD55" />
      <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#E9C94B" />
      <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#C8AA3B" />
      <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#260052" />
      <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource CardStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="24" />
        <Setter Property="Margin" Value="0,0,0,16" />
      </Style>
      <Style x:Key="SectionHeading" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource FocusAccentBrush}" />
        <Setter Property="Margin" Value="0,0,0,8" />
      </Style>
      <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Margin" Value="0,12,0,5" />
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
