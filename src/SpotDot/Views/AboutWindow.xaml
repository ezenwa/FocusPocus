<ui:FluentWindow x:Class="SpotDot.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="FocusPocus" Width="440" Height="310"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowCornerPreference="Round"
        ExtendsContentIntoTitleBar="True"
        Background="{DynamicResource ApplicationBackgroundBrush}">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <ui:TitleBar Grid.Row="0" Title="FocusPocus" ShowMinimize="False" ShowMaximize="False" ShowClose="True"/>

    <Border Grid.Row="1" Margin="24" Padding="22" CornerRadius="14"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="94"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Width="78" Height="78" CornerRadius="39" Background="#18FFDD55" VerticalAlignment="Top" HorizontalAlignment="Left">
            <Image Width="70" Height="70" Source="/Assets/FocusPocus.png"/>
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="FocusPocus" FontSize="27" FontWeight="SemiBold" Foreground="{DynamicResource AccentFillColorDefaultBrush}"/>
            <TextBlock x:Name="TaglineText" Margin="0,4,0,14" FontSize="13" Foreground="{StaticResource SpotMutedBrush}"/>
            <TextBlock x:Name="VersionText" FontSize="14"/>
            <TextBlock x:Name="AuthorText" Margin="0,5,0,0" FontSize="14" Foreground="{StaticResource SpotMutedBrush}"/>
          </StackPanel>
        </Grid>
        <ui:Button x:Name="CloseButton" Grid.Row="1" HorizontalAlignment="Right" MinWidth="104"
                   Appearance="Primary" Click="CloseClicked"/>
      </Grid>
    </Border>
  </Grid>
</ui:FluentWindow>
